{
  "hooks": {
    "SessionStart": [
      {"hooks": [{"type": "command", "command": "\"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/session_start.sh"}]}
    ],
    "PreToolUse": [
      {"matcher": "Edit|Write|MultiEdit|NotebookEdit",
       "hooks": [{"type": "command", "command": "python3 \"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/guard_paths.py"}]},
      {"matcher": "Bash",
       "hooks": [{"type": "command", "command": "python3 \"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/guard_paths.py"}]}
    ],
    "Stop": [
      {"hooks": [{"type": "command", "command": "python3 \"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/on_stop.py", "timeout": 150}]}
    ]
  }
,
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch --show-current)",
      "Bash(git rev-parse:*)",
      "Bash(git remote get-url:*)",
      "Bash(ls:*)",
      "Bash(python tests/test_*.py)",
      "Bash(python tests/ui_smoke.py)",
      "Read",
      "Glob",
      "Grep"
    ],
    "ask": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)"
    ],
    "deny": [
      "Bash(rm:*)",
      "Bash(mv:*)",
      "Bash(curl:*)",
      "Bash(wget:*)"
    ]
  }
}
